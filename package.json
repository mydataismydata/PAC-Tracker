{
  "name": "pac-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "probe:fldoe": "tsx --env-file-if-exists=.env scripts/probe-fldoe.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "probe:voterfocus": "tsx --env-file-if-exists=.env scripts/probe-voterfocus.ts",
    "trace": "tsx scripts/trace.ts"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
