# Postgres. Matches docker-compose.yml; port 5439 avoids clashing with a local
# Postgres on the default 5432.
DATABASE_URL=postgres://pactracker:pactracker@localhost:5439/pactracker
DATABASE_POOL_MAX=10

# Politeness controls for the Florida Division of Elections scraper.
# Their CGI backend is a single SQL Server box behind Cloudflare; keep the
# request rate low and identify the crawler honestly.
FLDOE_REQUEST_DELAY_MS=1500
FLDOE_MAX_RETRIES=3
FLDOE_USER_AGENT=PACTracker/0.1 (+https://github.com/mydataismydata/PAC-Tracker)

# Outbound mail, for the "request an account" form on the sign-in page.
# Leave unset and the form is not offered at all; nothing else depends on it.
# These are IONOS's settings — port 587 upgrades with STARTTLS, 465 is
# implicit TLS. SMTP_USER must be a real mailbox, and IONOS will only accept
# SMTP_FROM if it is that same mailbox.
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=
SMTP_FROM=you@yourdomain.com
# Where requests land. Defaults to SMTP_FROM.
ACCESS_REQUEST_TO=you@yourdomain.com
