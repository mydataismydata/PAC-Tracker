# Postgres. Matches docker-compose.yml; port 5439 avoids clashing with a local
# Postgres on the default 5432.
DATABASE_URL=postgres://pactracker:pactracker@localhost:5439/pactracker
DATABASE_POOL_MAX=10

# Politeness controls for the Florida Division of Elections scraper.
# Their CGI backend is a single SQL Server box behind Cloudflare; keep the
# request rate low and identify the crawler honestly.
FLDOE_REQUEST_DELAY_MS=1500
FLDOE_MAX_RETRIES=3
FLDOE_USER_AGENT=PACTracker/0.1 (+https://github.com/mydataismydata/PAC-Tracker)

# Starting site password, used only to seed a database that has no password row
# yet. After the first change from the header it is ignored; to fall back to it,
# delete the gate.password row from app_settings.
GATE_PASSWORD=liberty
