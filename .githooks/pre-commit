#!/bin/sh
# pre-commit: stamp the build number into src/lib/build.json.
#
# The build number is the commit count with this commit included. It rises by
# one with every commit, and `git rev-list --count HEAD` checks it. Nothing
# else writes the file, so staging it here never sweeps up an unfinished edit.
#
# An amend replaces HEAD instead of adding to it, so it keeps HEAD's count.
#
# Enable once per clone:  git config core.hooksPath .githooks

set -e

n=$(git rev-list --count HEAD 2>/dev/null || echo 0)
case "$(ps -o args= -p "$PPID" 2>/dev/null)" in
  *--amend*) ;;
  *) n=$((n + 1)) ;;
esac

file="$(git rev-parse --show-toplevel)/src/lib/build.json"
printf '{ "build": %s }\n' "$n" > "$file"
git add "$file"

exec "$(dirname "$0")/chain" pre-commit "$@"
