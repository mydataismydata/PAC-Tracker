#!/bin/sh
# Runs the global hook of the given name, if there is one.
#
# A repo-local core.hooksPath replaces the global one rather than adding to
# it. Every hook in this folder ends here, so a hook set up for every
# repository on the machine keeps running in this one. A global hook with a
# name not in this folder does not run here; add a two-line file like
# commit-msg to bring it in.

name=$1
shift

global=$(git config --global --get core.hooksPath 2>/dev/null) || exit 0
here=$(cd "$(dirname "$0")" && pwd -P)
there=$(cd "$global" 2>/dev/null && pwd -P) || exit 0

# Pointing the global path at this folder would otherwise loop forever.
[ "$there" = "$here" ] && exit 0
[ -x "$there/$name" ] || exit 0
exec "$there/$name" "$@"
